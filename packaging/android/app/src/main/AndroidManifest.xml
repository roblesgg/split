<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Recibe la alarma de un recordatorio y saca la notificación.
             No exportado: solo lo despierta la propia app. -->
        <receiver
            android:name=".RecordatorioReceiver"
            android:enabled="true"
            android:exported="false" />

        <!-- Los widgets de la pantalla de inicio. Exportados a la fuerza:
             quien los coloca y los repinta es el lanzador del sistema, que
             es otra app. Lo único que hacen es leer la foto que la app deja
             guardada y abrir la app; no reciben datos de nadie. -->
        <receiver
            android:name=".SaldoWidget"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_saldo_info" />
        </receiver>

        <receiver
            android:name=".LimiteWidget"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_limite_info" />
        </receiver>

        <receiver
            android:name=".ApuntarWidget"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_apuntar_info" />
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Para abrir el instalador con el APK que la propia app descarga.
         Android sigue pidiendo confirmación al usuario: esto solo evita
         tener que pasar por el navegador. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Avisos de lo que toca cobrar. Desde Android 13 hay que pedirlo al
         usuario; antes bastaba con declararlo. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Sin esto, desde Android 12 la alarma es «inexacta» y el sistema
         puede correrla horas para ahorrar batería. En un aviso de «hoy
         cobras, dime cuánto» eso es la diferencia entre servir y no
         servir. No se concede de oficio: el usuario lo da desde los
         ajustes del móvil, y la app lo lleva ahí cuando hace falta. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
</manifest>
