<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <!-- La barra de estado y la de navegación toman el color de página de
         la app, y sus iconos se oscurecen porque el fondo es claro.
         values-night invierte ambas cosas. -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@color/splitPage</item>
        <item name="android:statusBarColor">@color/splitPage</item>
        <item name="android:navigationBarColor">@color/splitPage</item>
                <!-- Desde Android 15 (SDK 35) el sistema fuerza el modo
             edge-to-edge e IGNORA statusBarColor y navigationBarColor:
             las barras salen transparentes y, sin nada que las pinte, se
             ven negras. Esto recupera el comportamiento de siempre. Deja
             de valer si algún día se apunta a SDK 36, y entonces habrá que
             pasar los insets del sistema al CSS (env(safe-area-inset-*)). -->
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="android:statusBarColor">@color/splitPage</item>
        <item name="android:navigationBarColor">@color/splitPage</item>
                <!-- Desde Android 15 (SDK 35) el sistema fuerza el modo
             edge-to-edge e IGNORA statusBarColor y navigationBarColor:
             las barras salen transparentes y, sin nada que las pinte, se
             ven negras. Esto recupera el comportamiento de siempre. Deja
             de valer si algún día se apunta a SDK 36, y entonces habrá que
             pasar los insets del sistema al CSS (env(safe-area-inset-*)). -->
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
