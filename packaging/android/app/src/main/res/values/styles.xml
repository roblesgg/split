<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>

        <!-- Sin agarraderas de selección: ver handle_invisible.xml -->
        <item name="android:textSelectHandle">@drawable/handle_invisible</item>
        <item name="android:textSelectHandleLeft">@drawable/handle_invisible</item>
        <item name="android:textSelectHandleRight">@drawable/handle_invisible</item>
    </style>

    <!-- La barra de estado y la de navegación toman el color de página de
         la app, y sus iconos se oscurecen porque el fondo es claro.
         values-night invierte ambas cosas. -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@color/splitPage</item>
        <item name="android:statusBarColor">@color/splitPage</item>
        <item name="android:navigationBarColor">@color/splitPage</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>

        <!-- Sin agarraderas de selección: ver handle_invisible.xml -->
        <item name="android:textSelectHandle">@drawable/handle_invisible</item>
        <item name="android:textSelectHandleLeft">@drawable/handle_invisible</item>
        <item name="android:textSelectHandleRight">@drawable/handle_invisible</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="android:statusBarColor">@color/splitPage</item>
        <item name="android:navigationBarColor">@color/splitPage</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
