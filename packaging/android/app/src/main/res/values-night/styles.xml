<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- En oscuro el fondo es casi negro, así que los iconos de las barras
         del sistema tienen que ir en claro. -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@color/splitPage</item>
        <item name="android:statusBarColor">@color/splitPage</item>
        <item name="android:navigationBarColor">@color/splitPage</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>

        <!-- Sin agarraderas de selección: ver handle_invisible.xml -->
        <item name="android:textSelectHandle">@drawable/handle_invisible</item>
        <item name="android:textSelectHandleLeft">@drawable/handle_invisible</item>
        <item name="android:textSelectHandleRight">@drawable/handle_invisible</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="android:statusBarColor">@color/splitPage</item>
        <item name="android:navigationBarColor">@color/splitPage</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
