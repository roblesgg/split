<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- En oscuro el fondo es casi negro, así que los iconos de las barras
         del sistema tienen que ir en claro. -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@color/splitPage</item>
        <item name="android:statusBarColor">@color/splitPage</item>
        <item name="android:navigationBarColor">@color/splitPage</item>
                <!-- Desde Android 15 (SDK 35) el sistema fuerza el modo
             edge-to-edge e IGNORA statusBarColor y navigationBarColor:
             las barras salen transparentes y, sin nada que las pinte, se
             ven negras. Esto recupera el comportamiento de siempre. Deja
             de valer si algún día se apunta a SDK 36, y entonces habrá que
             pasar los insets del sistema al CSS (env(safe-area-inset-*)). -->
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="android:statusBarColor">@color/splitPage</item>
        <item name="android:navigationBarColor">@color/splitPage</item>
                <!-- Desde Android 15 (SDK 35) el sistema fuerza el modo
             edge-to-edge e IGNORA statusBarColor y navigationBarColor:
             las barras salen transparentes y, sin nada que las pinte, se
             ven negras. Esto recupera el comportamiento de siempre. Deja
             de valer si algún día se apunta a SDK 36, y entonces habrá que
             pasar los insets del sistema al CSS (env(safe-area-inset-*)). -->
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
