<?xml version="1.0" encoding="utf-8"?>
<!-- Saldo de la cuenta con la que operas, en su tamaño normal.
     La pastilla de color va pegada al nombre, nunca sola: el color
     identifica, pero quien lo dice es el nombre. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wsRaiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/widget_fondo"
    android:padding="@dimen/widget_aire">

    <ImageView
        android:id="@+id/wsRail"
        android:layout_width="5dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="12dp"
        android:src="@drawable/widget_rail"
        android:scaleType="fitXY"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/wsNombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/widgetTintaSuave" />

        <TextView
            android:id="@+id/wsSaldo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="27sp"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="-0.035"
            android:textColor="@color/widgetTinta" />

        <TextView
            android:id="@+id/wsTipo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textAllCaps="true"
            android:textSize="10sp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.09"
            android:textColor="@color/widgetTintaSuave" />
    </LinearLayout>
</LinearLayout>
