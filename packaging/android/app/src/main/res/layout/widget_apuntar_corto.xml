<?xml version="1.0" encoding="utf-8"?>
<!-- En una sola celda no cabe el rótulo: solo el botón, que a ese tamaño
     es lo único que hace falta. Un «+» en el color de la app se entiende
     sin leer nada. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/waRaiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/widget_fondo"
    android:padding="6dp">

    <TextView
        android:id="@+id/waCirculo"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/widget_boton"
        android:gravity="center"
        android:text="+"
        android:textSize="25sp"
        android:fontFamily="sans-serif-medium"
        android:textColor="#FFFFFF" />

    <TextView
        android:id="@+id/waTexto"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />
</LinearLayout>
