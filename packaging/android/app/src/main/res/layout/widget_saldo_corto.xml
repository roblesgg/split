<?xml version="1.0" encoding="utf-8"?>
<!-- El mismo, en una fila de alto. Cae el tipo de cuenta y el nombre se
     va al lado del saldo: en 40dp no caben tres renglones, y meterlos
     con calzador es la forma segura de que no se lea ninguno. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wsRaiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/widget_fondo"
    android:padding="@dimen/widget_aire_corto">

    <ImageView
        android:id="@+id/wsRail"
        android:layout_width="5dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="10dp"
        android:src="@drawable/widget_rail"
        android:scaleType="fitXY"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/wsNombre"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:maxLines="1"
        android:ellipsize="end"
        android:textSize="13sp"
        android:fontFamily="sans-serif-medium"
        android:textColor="@color/widgetTintaSuave" />

    <TextView
        android:id="@+id/wsSaldo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:textSize="19sp"
        android:fontFamily="sans-serif-black"
        android:letterSpacing="-0.03"
        android:textColor="@color/widgetTinta" />

    <!-- No se enseña, pero existe: así el código que pinta es uno solo y
         no tiene que saber en qué layout está. -->
    <TextView
        android:id="@+id/wsTipo"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />
</LinearLayout>
