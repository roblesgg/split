<?xml version="1.0" encoding="utf-8"?>
<!-- El mismo en una fila: nombre, porcentaje y barra. Lo que queda en
     euros se cae, que es el renglón que menos se echa de menos cuando ya
     ves la barra y el porcentaje. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wlRaiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:background="@drawable/widget_fondo"
    android:padding="@dimen/widget_aire_corto">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/wlNombre"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/widgetTinta" />

        <TextView
            android:id="@+id/wlPct"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:textSize="13sp"
            android:fontFamily="sans-serif-black"
            android:textColor="@color/widgetBien" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/wlBarra"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="7dp"
        android:layout_marginTop="7dp"
        android:max="100"
        android:progressDrawable="@drawable/widget_barra" />

    <TextView
        android:id="@+id/wlQueda"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/wlTexto"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />
</LinearLayout>
