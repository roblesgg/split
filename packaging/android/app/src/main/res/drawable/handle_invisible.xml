<?xml version="1.0" encoding="utf-8"?>
<!--
  Un punto transparente de un píxel.

  Es lo que se le da a Android como agarradera de selección de texto. Los
  gotones verdes que salían debajo del cursor cada vez que se tocaba un
  campo son de la plantilla del sistema, no de la app, y en una pantalla
  de finanzas cantan muchísimo.

  Quitarlos no impide escribir ni colocar el cursor tocando: lo único que
  se pierde es poder ARRASTRAR el cursor, y en campos de un importe o un
  título de cuarenta letras eso no hace falta.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
       android:shape="rectangle">
    <size android:width="1dp" android:height="1dp" />
    <solid android:color="@android:color/transparent" />
</shape>
